# OpenCode Configuration — Environment Variables
#
# Copy this file to ~/.config/opencode/.env and fill in your values.
# The setup.sh script can do this automatically for you.
#
# This file is a template — it contains NO secrets.
# The real .env file must NEVER be committed to the repository.

# ─── Required ───────────────────────────────────────────────────────────────

# Your Infomaniak AI API key (found in the Infomaniak console)
OPENAI_API_KEY=

# Infomaniak AI API endpoint
OPENAI_BASE_URL=https://api.infomaniak.com/2/ai/private/openai/v1

# ─── Optional ───────────────────────────────────────────────────────────────

# B300 endpoint (Kimi K2.6 dedicated instance)
# Only needed if you use the build-b300 agent
OPENAI_B300_BASE_URL=https://kimi-k26-nvfp4.ia2-kub.infomaniak.ch/v1

# iOS Simulator MCP — UDID of the simulator to use
# Auto-detected by setup.sh on macOS. Find it manually with:
#   xcrun simctl list devices available | grep -m1 "Boot"
IDB_UDID=

# iOS Simulator MCP — PATH to idb binaries
# Defaults to the standard idb-companion install location
# NOTE: Replace $HOME with your actual home path if you set this up manually.
#       setup.sh expands $HOME automatically.
IDB_PATH=$HOME/.local/idb-venv/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
