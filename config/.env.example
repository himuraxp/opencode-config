# OpenCode Configuration — Environment Variables
#
# Copy this file to ~/.config/opencode/.env and fill in your values.
# The setup.sh script can do this automatically for you.
#
# This file is a template — it contains NO secrets.
# The real .env file must NEVER be committed to the repository.

# ─── Required ───────────────────────────────────────────────────────────────

# Your Infomaniak AI API key (found in the Infomaniak console)
# NOTE: This is separate from OPENAI_API_KEY to avoid collisions with
#       other OpenAI-compatible providers. Do NOT use OPENAI_API_KEY for Infomaniak.
OPENAI_API_KEY_INFOMANIAK=

# Infomaniak AI API endpoint
OPENAI_BASE_URL=https://api.infomaniak.com/2/ai/private/openai/v1

# ─── Optional ───────────────────────────────────────────────────────────────

# B300 endpoint (Kimi K2.6 dedicated instance)
# Only needed if you use the build-b300 agent.
# NOTE: This endpoint does NOT require an Authorization header — it is an
# internal Infomaniak endpoint with IP-based or network-level authentication.
# The euria-code model on this provider has extended parameters (thinking,
# repetitionPenalty, stopSequences) that the standard infomaniak provider does not.
OPENAI_B300_BASE_URL=https://kimi-k26-nvfp4.ia2-kub.infomaniak.ch/v1

# iOS Simulator MCP — UDID of the simulator to use
# Only needed if you installed the iOS Simulator MCP (setup.sh asks).
# Auto-detected by setup.sh on macOS. Find it manually with:
#   xcrun simctl list devices available | grep -m1 "Boot"
IDB_UDID=

# iOS Simulator MCP — PATH to idb binaries
# Only needed if you installed the iOS Simulator MCP (setup.sh asks).
# Defaults to the standard idb-companion install location
# NOTE: Replace $HOME with your actual home path if you set this up manually.
#       setup.sh expands $HOME automatically.
IDB_PATH=$HOME/.local/idb-venv/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

# Infomaniak API token (for the Infomaniak MCP server)
# Get your token at: https://manager.infomaniak.com/v3/ng/accounts/token/list
# Required by the infomaniak MCP server (events, profile, accounts, AI, VOD, newsletter, DNS, etc.)
INFOMANIAK_API_TOKEN=

# GitLab token (for the Angular Elements MCP server)
# Required by the angular-elements MCP server (component docs, API, stories, install info)
# Get your token at: https://gitlab.infomaniak.ch/-/profile/personal_access_tokens
GITLAB_TOKEN=
