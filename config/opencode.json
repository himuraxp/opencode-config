    "aurora": {
      "model": "infomaniak/euria-code",
      "permission": {
        "edit": "allow",
        "bash": {
          // === Default: tout autorisé sauf exceptions ===
          "*": "allow",

          // --- Ask: commandes sensibles nécessitant confirmation ---
          // Git destructif
          "git push *": "ask",
          "git push --force*": "ask",
          // Boucle infinie
          "watch *": "ask",
          // Fuite de secrets
          "env *": "ask",
          "printenv*": "ask",
          // Exfiltration réseau (envoi de données vers remote)
          "curl *-X POST*": "ask",
          "curl *--data*": "ask",
          "curl *-d *": "ask",
          "curl *-F *": "ask",
          "curl *--upload-file*": "ask",
          "curl *-T *": "ask",
          "scp *": "ask",
          "rsync *": "ask",
          "wget *--post*": "ask",
          // Persistance / modification système macOS
          "launchctl load*": "ask",
          "launchctl bootstrap*": "ask",
          "launchctl enable*": "ask",
          "crontab *": "ask",
          "defaults write*": "ask",
          // Modification de permissions récursive
          "chmod -R *": "ask",
          "chown -R *": "ask",
          // Process management par nom (vs PID)
          "killall *": "ask",
          "pkill *": "ask",

          // --- Deny: commandes destructives non négociables ---
          // Escalade de privilèges
          "sudo *": "deny",
          "su *": "deny",
          "doas *": "deny",
          // Suppression de masse (élargi)
          "rm -rf /*": "deny",
          "rm -rf /": "deny",
          "rm -rf /Users*": "deny",
          "rm -rf ~*": "deny",
          "rm -rf /var*": "deny",
          "rm -rf /etc*": "deny",
          "rm -rf /System*": "deny",
          "rm -rf /Library*": "deny",
          "find * -delete": "deny",
          "find * -exec rm*": "deny",
          // Destruction de disque/partition macOS
          "dd *of=/dev/*": "deny",
          "diskutil eraseDisk*": "deny",
          "diskutil eraseVolume*": "deny",
          "diskutil reformat*": "deny",
          "mkfs*": "deny",
          "fdisk *": "deny"
        },
        "webfetch": "allow",
        "external_directory": {
          // =============================================================
          // Modèle inversé : tout allow sauf exceptions deny/ask
          // Règle : 'last matching rule wins' → deny en dernier
          // =============================================================

          // --- Catch-all : tout autorisé par défaut ---
          "*": "allow",

          // --- Ask : chemins sensibles mais accès légitime possible ---
          // Système : configs, bibliothèques, logs
          "/Library/*": "ask",
          "/usr/local/*": "ask",
          "/opt/homebrew/*": "ask",
          "/etc/*": "ask",
          "/private/etc/*": "ask",
          "/var/log/*": "ask",
          "/private/var/log/*": "ask",
          // macOS : cookies et données partagées entre apps
          "~/Library/Cookies/*": "ask",
          "~/Library/Group Containers/*": "ask",

          // --- Deny : secrets et système critique, aucun accès ---
          // Système macOS
          "/System/*": "deny",
          "/private/etc/master.passwd": "deny",
          "/etc/master.passwd": "deny",
          "/private/var/db/dslocal/*": "deny",
          // Clés cryptographiques
          "~/.ssh/*": "deny",
          "~/.gnupg/*": "deny",
          "~/Library/Keychains/*": "deny",
          // Credentials cloud et services
          "~/.aws/credentials": "deny",
          "~/.aws/config": "deny",
          "~/.kube/config": "deny",
          "~/.docker/config.json": "deny",
          "~/.netrc": "deny",
          "~/.git-credentials": "deny",
          // Secrets OpenCode (defense-in-depth, .env déjà deny par read par défaut)
          "~/.config/opencode/.env*": "deny"
        }
      }
    },
