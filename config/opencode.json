  "plugin": [
    "oh-my-opencode-slim"
  ],
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless",
        "--isolated"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "ios-simulator": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "ios-simulator-mcp"
      ],
      "enabled": true,
      "timeout": 30000,
      "env": {
        "PATH": "{env:IDB_PATH}",
        "IDB_UDID": "{env:IDB_UDID}"
      }
    },
    "infomaniak": {
      "type": "local",
      "command": [
        "node",
        "{env:OPENCODE_CONFIG_DIR}/mcp/infomaniak/dist/index.js"
      ],
      "enabled": true,
      "timeout": 30000,
      "env": {
        "INFOMANIAK_API_TOKEN": "{env:INFOMANIAK_API_TOKEN}"
      }
    }
  },
  "lsp": true,
  "permission": {
    "external_directory": {
      "/tmp/*": "allow",
      "/private/tmp/*": "allow"
    }
  }
}
