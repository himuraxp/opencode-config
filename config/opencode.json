    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "security": {
      "model": "infomaniak/Qwen/Qwen3.5-397B-A17B-FP8",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "npm audit *": "allow",
          "yarn audit *": "allow",
          "npx audit *": "allow",
